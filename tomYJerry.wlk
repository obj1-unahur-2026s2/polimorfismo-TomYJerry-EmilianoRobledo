object tom {
    var energy = 50
    method estaFeliz() = energy > 50


    method ratonComido() = raton
    method distanciaRecorrida() = distanciaMetros
    method velocidadMaxima() = energy
    // method energia() = energy  
    method correr(metros) {
        energy = energy - (metros /2)  
    }
}

